# ─── Database ─────────────────────────────────────────────────
DB_PASSWORD=password          # Change in production
DB_HOST=postgres              # Use "localhost" for local dev outside Docker
DB_PORT=5432
DB_NAME=kspdb
DB_USER=postgres

# ─── Backend ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── AI Summaries (optional) ──────────────────────────────────
# Leave blank to use template-based summaries (no API key needed)
# Set to enable LLM-generated operator narratives via gpt-4o-mini
OPENAI_API_KEY=
